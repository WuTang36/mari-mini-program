/* 全局样式 */
page {
  box-sizing: border-box;
  --color-primary: #FF9800;
  --color-primary-light: #FFB74D;
  --color-bg: #F8F6F2;
  --color-card: #FFFFFF;
  --color-text: #2D2D2D;
  --color-text-secondary: #555555;
  --color-text-hint: #999999;
  --color-text-placeholder: #C8B8A0;
  --color-border: #F5F2ED;
  --color-divider: #E8E4DC;
  --color-danger: #FF5252;
  --color-success: #4CAF50;
  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-family: var(--font-family);
  background-color: var(--color-bg);
  font-size: 28rpx;
  color: var(--color-text);
}

/* 通用导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
  gap: 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  flex-shrink: 0;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
}

/* 通用卡片 */
.card {
  background: var(--color-card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

/* 通用按钮 */
.btn-primary {
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 通用表单行 */
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
  min-height: 96rpx;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  width: 160rpx;
  flex-shrink: 0;
}

.form-label.required::after {
  content: ' *';
  color: var(--color-danger);
  font-size: 24rpx;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.form-value.placeholder {
  color: var(--color-text-placeholder);
}

.form-input {
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  border: none;
  background: none;
  outline: none;
}

.form-arrow {
  font-size: 28rpx;
  color: #CCC;
  flex-shrink: 0;
}

/* 滚动区域 */
.content-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
}

/* 状态栏占位 */
.status-bar-placeholder {
  padding: 24rpx 48rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 600;
}
