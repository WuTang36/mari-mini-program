page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
}

.mine-content {
  padding: 0 32rpx 120rpx;
}

/* ========== 用户卡片 ========== */

.user-card {
  box-sizing: border-box;
  margin: 32rpx 0;
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 56rpx;
  line-height: 1;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-placeholder {
  font-size: 32rpx;
  font-weight: 700;
  color: #07C160;
  display: block;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: block;
}

.logout-btn {
  font-size: 22rpx;
  color: #999;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid #E0E0E0;
  flex-shrink: 0;
}

/* ========== 菜单 ========== */

.menu-card {
  background: var(--color-card);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  margin-bottom: 32rpx;
}

.menu-item {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  border-bottom: 2rpx solid var(--color-border);
  gap: 24rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.menu-arrow {
  font-size: 28rpx;
  color: #CCC;
  flex-shrink: 0;
}

.version {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* ========== 关于我们弹窗 ========== */
.about-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.about-panel {
  box-sizing: border-box;
  position: relative;
  width: 100%;
  max-width: 640rpx;
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 64rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  font-size: 32rpx;
  color: #BBB;
  padding: 8rpx;
  line-height: 1;
}

.about-logo-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  margin-bottom: 20rpx;
}

.about-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.about-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.9;
  text-align: center;
  margin-bottom: 32rpx;
}

.about-desc-line {
  display: block;
}

.about-wechat {
  width: 100%;
  box-sizing: border-box;
  background: #F5F3EF;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.about-wechat-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.about-wechat-id {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.about-btn {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.3);
}
