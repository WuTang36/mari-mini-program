page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  padding-bottom: 120rpx;
  flex: 1;
  overflow-y: auto;
}

.nav-actions {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.nav-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--color-danger);
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.reminder-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.reminder-bar {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  border: 2rpx solid var(--color-border);
}

.reminder-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.reminder-count {
  font-size: 26rpx;
  font-weight: 700;
  color: #E65100;
  flex: 1;
}

.reminder-num {
  color: var(--color-primary);
}

.reminder-hint {
  font-size: 22rpx;
  color: #B8A898;
}

.reminder-arrow {
  font-size: 32rpx;
  color: #CCC;
  flex-shrink: 0;
}

.guide-banner {
  margin: 0 32rpx 28rpx;
  background: linear-gradient(135deg, #FF9800, #FFB74D);
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.25);
}

.guide-emoji {
  font-size: 72rpx;
  flex-shrink: 0;
}

.guide-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.guide-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.guide-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  white-space: nowrap;
}

.guide-action {
  background: #fff;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

/* 宠物卡片（可滑动） */
.pet-card-wrapper {
  margin: 0 32rpx 24rpx;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
}

.pet-card {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  position: relative;
  z-index: 1;
  transition: transform 0.2s ease;
}

.pet-card.swiped {
  transform: translateX(-160rpx);
}

.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #FF5252;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 32rpx 32rpx 0;
  z-index: 0;
}

.delete-btn text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.pet-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.pet-avatar image {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
}

.pet-avatar-emoji {
  width: 100%;
  height: 100%;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.pet-meta {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pet-meta-dot {
  width: 6rpx;
  height: 6rpx;
  background: #DDD;
  border-radius: 50%;
}

/* 性别符号：使用 inline-flex 确保与文字水平对齐 */
.pet-meta .gender-dot {
  font-size: 18rpx;
  line-height: 1;
  margin-right: 2rpx;
}

.pet-meta .gender-dot.male {
  color: #42A5F5;
}

.pet-meta .gender-dot.female {
  color: #EC407A;
}

.pet-arrow {
  font-size: 32rpx;
  color: #CCC;
  flex-shrink: 0;
}

.pet-status {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.status-tag.warning {
  background: #FFF3E0;
  color: #E65100;
}

.status-tag.ok {
  background: #E8F5E9;
  color: #2E7D32;
}

.add-pet-btn {
  margin: 0 32rpx 28rpx;
  background: var(--color-card);
  border: 4rpx dashed #E0D8CC;
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #B8A898;
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== 删除宠物警示弹窗 ========== */
.delete-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
}

.delete-panel {
  box-sizing: border-box;
  width: 100%;
  max-width: 600rpx;
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.delete-icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.delete-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-danger);
  margin-bottom: 16rpx;
}

.delete-desc {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.delete-sub {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 32rpx;
}

.delete-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.del-option {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.del-option.keep {
  background: #F5F3EF;
  color: var(--color-text-secondary);
}

.del-option.danger {
  background: var(--color-danger);
  color: #fff;
}

.delete-cancel {
  font-size: 26rpx;
  color: var(--color-text-hint);
  padding: 8rpx 24rpx;
}
