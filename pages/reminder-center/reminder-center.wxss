page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
}

.subscribe-banner {
  margin: 24rpx 0 20rpx;
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.subscribe-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.subscribe-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.subscribe-content {
  flex: 1;
  min-width: 0;
}

.subscribe-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1565C0;
  display: block;
  margin-bottom: 4rpx;
}

.subscribe-desc {
  font-size: 22rpx;
  color: #42A5F5;
}

.subscribe-btn {
  background: #1565C0;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.read-all-bar {
  display: flex;
  justify-content: flex-end;
  padding: 0 0 16rpx;
}

.read-all-btn {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: #FFF3E0;
  border-radius: 20rpx;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reminder-item {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.reminder-item.read {
  opacity: 0.6;
}

.reminder-item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.reminder-item-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.reminder-item-info {
  flex: 1;
  min-width: 0;
}

.reminder-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  display: block;
  margin-bottom: 6rpx;
}

.reminder-item-title.strikethrough {
  text-decoration: line-through;
  color: var(--color-text-hint);
}

.reminder-item-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
  display: block;
}

.reminder-item-desc.strikethrough {
  text-decoration: line-through;
}

.reminder-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.reminder-item-date {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--color-danger);
  border-radius: 50%;
}

.read-check {
  font-size: 24rpx;
  color: var(--color-success);
  font-weight: 700;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.reminder-center-content {
  padding: 0 32rpx;
}

/* 已订阅横幅（绿色） */
.subscribe-banner.subscribed {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.subscribe-banner.subscribed .subscribe-title {
  color: #2E7D32;
}

.subscribe-banner.subscribed .subscribe-desc {
  color: #66BB6A;
}

/* 取消订阅按钮 */
.subscribe-btn.cancel {
  background: #9E9E9E;
  color: #fff;
}
