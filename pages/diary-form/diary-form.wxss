page { height: 100%; display: flex; flex-direction: column; background: var(--color-bg); }
.page-scroll { flex: 1; overflow-y: auto; padding: 24rpx 0; }
.form-card { margin: 0 56rpx 28rpx; background: var(--color-card); border-radius: 32rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); }
.form-row { display: flex; align-items: center; padding: 32rpx 36rpx; border-bottom: 2rpx solid var(--color-border); min-height: 96rpx; }
.form-row:last-child { border-bottom: none; }
.form-label { font-size: 28rpx; font-weight: 600; color: var(--color-text-secondary); width: 140rpx; flex-shrink: 0; }
.form-label.required::after { content: ' *'; color: var(--color-danger); font-size: 24rpx; }
.form-value { flex: 1; font-size: 28rpx; color: var(--color-text); text-align: right; }
.form-input { flex: 1; font-size: 28rpx; color: var(--color-text); text-align: right; border: none; background: none; outline: none; }
.form-arrow { font-size: 28rpx; color: #CCC; flex-shrink: 0; margin-left: 12rpx; }

.desc-row { flex-direction: column; align-items: flex-start; gap: 16rpx; }
.form-textarea { box-sizing: border-box; width: 100%; font-size: 28rpx; color: var(--color-text); border: none; background: none; outline: none; min-height: 120rpx; line-height: 1.6; }

.media-row { flex-direction: column; align-items: flex-start; gap: 16rpx; }
.media-actions { display: flex; gap: 20rpx; width: 100%; }
.media-action-btn { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 24rpx; background: #F5F3EF; border-radius: 20rpx; }
.media-action-icon { font-size: 40rpx; }
.media-action-label { font-size: 22rpx; color: var(--color-text-secondary); }

.media-preview { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0 36rpx 24rpx; }
.media-preview-item { width: 140rpx; height: 140rpx; border-radius: 16rpx; overflow: hidden; position: relative; }
.media-preview-item image { width: 100%; height: 100%; }
.media-remove { position: absolute; top: 4rpx; right: 4rpx; width: 36rpx; height: 36rpx; background: rgba(0,0,0,0.5); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20rpx; }

.tag-row { flex-direction: column; align-items: flex-start; gap: 16rpx; }
.tag-select { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-option { font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 20rpx; background: #F5F2ED; color: var(--color-text-hint); font-weight: 500; }
.tag-option.active { background: #FFEBEE; color: #C62828; font-weight: 700; }

.save-section { margin: 0 56rpx; padding: 24rpx 0 80rpx; }

.sheet-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 1000; display: none; align-items: flex-end; }
.sheet-overlay.show { display: flex; }
.sheet-panel { box-sizing: border-box; width: 100%; background: #fff; border-radius: 40rpx 40rpx 0 0; max-height: 600rpx; display: flex; flex-direction: column; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; padding: 36rpx 40rpx 24rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { font-size: 36rpx; color: #CCC; }
.date-picker-view { box-sizing: border-box; width: 100%; height: 400rpx; }
.picker-item { display: flex; align-items: center; justify-content: center; height: 50px; font-size: 28rpx; }
.sheet-footer { padding: 0 40rpx; }

/* 视频占位（避免用 image 渲染视频文件触发 Skyline WXS 报错） */
.media-preview-video {
  width: 100%;
  height: 100%;
  background: #263238;
  display: flex;
  align-items: center;
  justify-content: center;
}
.media-preview-video-icon {
  font-size: 48rpx;
}

/* 宠物选择 */
.pet-row {
  align-items: flex-start;
  padding: 24rpx 36rpx;
}

.pet-selector {
  flex: 1;
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.pet-selector::-webkit-scrollbar {
  display: none;
}

.pet-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #F5F2ED;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  flex-shrink: 0;
}

.pet-chip.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.pet-chip-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pet-chip-emoji {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pet-chip-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.pet-chip.active .pet-chip-name {
  color: #fff;
}

.pet-empty {
  flex: 1;
  text-align: right;
}

.pet-empty-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
