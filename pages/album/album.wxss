page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
}

/* 顶部固定区 */
.album-header {
  flex: none;
  background: var(--color-bg);
  padding: 0 32rpx;
}

.album-header-inner {
  background: var(--color-bg);
}

.pet-selector-wrap {
  overflow: hidden;
}

.pet-selector {
  white-space: nowrap;
  overflow-x: auto;
  padding: 24rpx 0;
  display: flex;
  gap: 16rpx;
  -webkit-overflow-scrolling: touch;
}

.pet-selector::-webkit-scrollbar {
  display: none;
}

.pet-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  background: var(--color-card);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
}

.pet-chip.active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.pet-chip-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pet-chip-emoji {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pet-chip-name {
  font-weight: 600;
}

.chip-archived-tag {
  font-size: 18rpx;
  color: #999;
  background: #F0EDE8;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  flex-shrink: 0;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 0 24rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
  background: var(--color-card);
  font-weight: 500;
}

.filter-item.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 700;
}

.timeline {
  padding-left: 0;
}

.timeline-month {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  padding: 24rpx 0 16rpx;
}

.timeline-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.timeline-left {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-top: 24rpx;
  flex-shrink: 0;
}

.timeline-line {
  flex: 1;
  width: 4rpx;
  background: var(--color-divider);
  min-height: 20rpx;
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-card {
  flex: 1;
  margin-bottom: 20rpx;
}

.photo-card {
  background: var(--color-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.photo-img {
  display: block;
  width: 100%;
  height: 320rpx;
  background: #F0EDE8;
}

.photo-placeholder {
  box-sizing: border-box;
  width: 100%;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-emoji {
  font-size: 96rpx;
}

.video-card {
  background: var(--color-card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.video-placeholder {
  box-sizing: border-box;
  width: 100%;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-icon {
  font-size: 80rpx;
}

/* 视频首帧封面 */
.video-cover {
  display: block;
  width: 100%;
  height: 320rpx;
  background: #000;
}

.photo-tag {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-card);
  font-weight: 600;
}

.diary-card {
  box-sizing: border-box;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.diary-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
}

.diary-tag {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #FFF3E0;
  color: #E65100;
  border-radius: 16rpx;
  font-weight: 600;
}

.timeline-date {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 浮动按钮 - 固定定位在页面底部 */
.fab-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  padding: 24rpx 48rpx;
  border-radius: 56rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.35);
  width: fit-content;
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  z-index: 10;
}

.fab-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
}

.fab-label {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}

.album-content {
  padding: 0 32rpx 200rpx;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0 16rpx;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
