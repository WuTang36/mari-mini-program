page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 0;
}

.record-card {
  background: var(--color-card);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.record-main {
  display: flex;
  gap: 20rpx;
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.record-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.record-status.expired {
  background: #FFEBEE;
  color: #C62828;
}

.record-status.warning {
  background: #FFF3E0;
  color: #E65100;
}

.record-status.normal {
  background: #E8F5E9;
  color: #2E7D32;
}

.record-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.record-value {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 疫苗本缩略图 */
.record-thumb {
  width: 120rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #F0EDE8;
  flex-shrink: 0;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 40rpx;
  background: linear-gradient(transparent, var(--color-bg) 40%);
}

.bottom-btn-text {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.3);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.empty-hint { font-size: 24rpx; color: var(--color-text-hint); }

.vaccine-list-content {
  padding: 0 32rpx;
}
