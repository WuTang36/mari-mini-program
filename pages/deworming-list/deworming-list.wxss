page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 16rpx;
}

.section-icon {
  font-size: 36rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
}

.section-count {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 空状态 — 统一风格 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.record-card {
  background: var(--color-card);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.record-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.record-status.expired {
  background: #FFEBEE;
  color: #C62828;
}

.record-status.warning {
  background: #FFF3E0;
  color: #E65100;
}

.record-status.normal {
  background: #E8F5E9;
  color: #2E7D32;
}

.record-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-row {
  display: flex;
  justify-content: space-between;
}

.record-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.record-value {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.fab-btn {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 152, 0, 0.35);
  z-index: 10;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
}

.sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  display: none;
  align-items: flex-end;
}

.sheet-overlay.show {
  display: flex;
}

.sheet-panel {
  box-sizing: border-box;
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 0 40rpx;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-close {
  font-size: 36rpx;
  color: #CCC;
}

.action-list {
  display: flex;
  padding: 20rpx 40rpx 40rpx;
  gap: 40rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  background: var(--color-bg);
  border-radius: 24rpx;
}

.action-icon {
  font-size: 56rpx;
}

.action-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.deworming-list-content {
  padding: 0 32rpx;
}
