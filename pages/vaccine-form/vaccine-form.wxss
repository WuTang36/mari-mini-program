page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 0;
}

.form-card {
  margin: 0 56rpx 28rpx;
  background: var(--color-card);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.form-row {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  border-bottom: 2rpx solid var(--color-border);
  min-height: 96rpx;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  width: 140rpx;
  flex-shrink: 0;
}

.form-label.required::after {
  content: ' *';
  color: var(--color-danger);
  font-size: 24rpx;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
}

.form-value.placeholder {
  color: var(--color-text-placeholder);
}

.form-value-row {
  flex: 1;
  text-align: right;
}

.auto-calc {
  color: var(--color-success);
}

.auto-tag {
  font-size: 20rpx;
  background: #E8F5E9;
  color: var(--color-success);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  border: none;
  background: none;
  outline: none;
}

.form-arrow {
  font-size: 28rpx;
  color: #CCC;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.photo-upload {
  color: var(--color-primary);
  font-weight: 500;
}

.save-section {
  margin: 0 56rpx;
  padding: 24rpx 0 80rpx;
}

.sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  display: none;
  align-items: flex-end;
}

.sheet-overlay.show {
  display: flex;
}

.sheet-panel {
  box-sizing: border-box;
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  max-height: 600rpx;
  display: flex;
  flex-direction: column;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-close {
  font-size: 36rpx;
  color: #CCC;
}

.sheet-list {
  max-height: 400rpx;
  padding: 0 40rpx;
}

.sheet-option {
  padding: 28rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
  border-bottom: 2rpx solid var(--color-border);
  display: flex;
  justify-content: space-between;
}

.sheet-option.selected {
  color: var(--color-primary);
  font-weight: 600;
}

.check {
  color: var(--color-primary);
}

.date-picker-view {
  box-sizing: border-box;
  width: 100%;
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50px;
  font-size: 28rpx;
}

.sheet-footer {
  padding: 0 40rpx;
}

/* 自定义疫苗弹窗 */
.dialog-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1100;
  display: none;
  align-items: center;
  justify-content: center;
}

.dialog-overlay.show {
  display: flex;
}

.dialog-panel {
  box-sizing: border-box;
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 24rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
}

.dialog-close {
  font-size: 36rpx;
  color: #CCC;
}

.dialog-body {
  padding: 0 40rpx 32rpx;
}

.dialog-input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  background: #F5F3EF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.dialog-footer {
  display: flex;
  border-top: 2rpx solid var(--color-border);
}

.dialog-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.dialog-btn.cancel {
  color: #999;
  border-right: 2rpx solid var(--color-border);
}

.dialog-btn.confirm {
  color: var(--color-primary);
  font-weight: 600;
}

/* 订阅引导弹窗 */
.guide-icon {
  font-size: 72rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.guide-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: center;
}
