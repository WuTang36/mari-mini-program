page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
}

.profile-card {
  margin: 32rpx 32rpx 24rpx;
  background: var(--color-card);
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04);
  position: relative;
}

.profile-edit {
  position: absolute;
  top: 28rpx;
  right: 32rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: linear-gradient(135deg, #FFE0B2, #FFCC80);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.profile-avatar image {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
}

.profile-avatar-emoji {
  width: 100%;
  height: 100%;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.profile-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #888;
}

.profile-meta-dot {
  width: 6rpx;
  height: 6rpx;
  background: #DDD;
  border-radius: 50%;
}

/* 性别符号：与文字水平对齐 */
.profile-meta .gender-dot {
  font-size: 20rpx;
  line-height: 1;
  margin-right: 2rpx;
}

.profile-meta .gender-dot.male {
  color: #42A5F5;
}

.profile-meta .gender-dot.female {
  color: #EC407A;
}

.profile-age-badge {
  background: #FFF3E0;
  color: #E65100;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.section-title {
  padding: 0 40rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-hint);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.func-grid {
  padding: 0 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.func-item {
  background: var(--color-card);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  position: relative;
}

.func-item.full-width {
  grid-column: 1 / -1;
}

.func-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.func-icon.vaccine { background: #E3F2FD; }
.func-icon.deworm { background: #F3E5F5; }
.func-icon.weight { background: #E8F5E9; }
.func-icon.medical { background: #FFEBEE; }
.func-icon.pedigree { background: #FFF8E1; }

.func-info {
  flex: 1;
  min-width: 0;
}

.func-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.func-desc {
  font-size: 22rpx;
  color: #AAA;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.func-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 14rpx;
  height: 14rpx;
  background: var(--color-danger);
  border-radius: 50%;
}

.quick-actions {
  padding: 0 32rpx;
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.quick-btn {
  flex: 1;
  background: var(--color-card);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.quick-btn-icon {
  font-size: 48rpx;
}

.quick-btn-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-hint);
}
