page { height: 100%; display: flex; flex-direction: column; background: var(--color-bg); }
.page-scroll { flex: 1; overflow-y: auto; padding: 24rpx 0; }

.pet-id-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  width: 100%;
  box-sizing: border-box;
}

.pet-id-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pet-id-emoji { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.pet-id-name { font-size: 28rpx; font-weight: 700; color: var(--color-text); display: block; }
.pet-id-meta { font-size: 22rpx; color: var(--color-text-hint); }

.timeline { padding-left: 0; }
.timeline-item { display: flex; gap: 20rpx; padding-bottom: 8rpx; }
.timeline-left { width: 40rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.timeline-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #FF5252; margin-top: 28rpx; flex-shrink: 0; }
.timeline-line { flex: 1; width: 4rpx; background: var(--color-divider); min-height: 20rpx; }
.timeline-item:last-child .timeline-line { display: none; }

.timeline-card {
  flex: 1;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-date { font-size: 22rpx; color: var(--color-text-hint); }
.card-tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 14rpx; font-weight: 600; }

.card-title { font-size: 28rpx; font-weight: 700; color: var(--color-text); display: block; margin-bottom: 8rpx; }
.card-desc { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.5; display: block; }

.card-thumb { width: 100%; height: 160rpx; border-radius: 16rpx; margin-top: 16rpx; background: #F0EDE8; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-secondary); }

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 40rpx;
  background: linear-gradient(transparent, var(--color-bg) 40%);
}

.bottom-btn-text {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.3);
}

.medical-list-content {
  padding: 0 32rpx;
}
