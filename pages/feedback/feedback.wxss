page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
}

.feedback-content {
  padding: 24rpx 32rpx 80rpx;
}

/* 顶部提示条 */
.tip-banner {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #E3F2FD;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #1565C0;
  line-height: 1.6;
}

/* 表单 */
.form-card {
  background: var(--color-card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  margin-bottom: 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
  min-height: 96rpx;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  width: 160rpx;
  flex-shrink: 0;
}

.form-label.required::after {
  content: ' *';
  color: var(--color-danger);
  font-size: 24rpx;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  border: none;
  background: none;
  outline: none;
}

.photo-upload {
  color: var(--color-primary);
  font-weight: 500;
}

.desc-row {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.form-textarea {
  box-sizing: border-box;
  width: 100%;
  font-size: 28rpx;
  color: var(--color-text);
  border: none;
  background: none;
  outline: none;
  min-height: 160rpx;
  line-height: 1.6;
}

.media-row {
  justify-content: space-between;
}

/* 媒体预览 */
.media-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.media-preview-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #F0EDE8;
}

.media-preview-item image {
  width: 100%;
  height: 100%;
}

.media-preview-video {
  width: 100%;
  height: 100%;
  background: #263238;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-preview-video-icon {
  font-size: 48rpx;
}

.media-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}

/* 提交 */
.save-section {
  padding: 0 8rpx;
}

/* 底部隐私提示 */
.privacy-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-hint);
  line-height: 1.6;
  padding: 0 32rpx;
}

/* 我的反馈记录入口 */
.history-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.history-entry-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.history-entry-info {
  flex: 1;
  min-width: 0;
}

.history-entry-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.history-entry-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.history-entry-arrow {
  font-size: 28rpx;
  color: #CCC;
  flex-shrink: 0;
}
