page { height: 100%; display: flex; flex-direction: column; background: var(--color-bg); }
.page-scroll { flex: 1; overflow-y: auto; padding: 24rpx 0; }
.preview-content { padding: 0 40rpx 80rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0; }
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.empty-hint { font-size: 24rpx; color: var(--color-text-hint); margin-bottom: 48rpx; }
.empty-btn {
  padding: 24rpx 88rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.3);
}

.cert-card {
  background: var(--color-card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.cert-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx 20rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
}

.cert-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  flex-shrink: 0;
  border: 4rpx solid rgba(255,255,255,0.6);
}

.cert-avatar-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.cert-pet-info { display: flex; flex-direction: column; gap: 4rpx; }
.cert-pet-name { font-size: 30rpx; font-weight: 800; color: #fff; }
.cert-title { font-size: 20rpx; color: rgba(255,255,255,0.85); letter-spacing: 2rpx; }

.cert-body { padding: 16rpx 32rpx; }
.cert-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid var(--color-border); }
.cert-row:last-child { border-bottom: none; }
.cert-label { font-size: 24rpx; color: var(--color-text-hint); flex-shrink: 0; }
.cert-value { font-size: 26rpx; color: var(--color-text); font-weight: 600; text-align: right; }

.cert-photo {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #F0EDE8;
}

.edit-btn {
  margin-top: 24rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.3);
}
