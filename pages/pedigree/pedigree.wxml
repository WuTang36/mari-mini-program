<!-- 血统信息 -->
<navigation-bar title="血统信息" back="{{true}}" color="black" background="#F8F6F2"></navigation-bar>

<scroll-view class="page-scroll" scroll-y>
  <!-- 提示条 -->
  <view class="info-tip">
    <text>💡 请填写宠物血统证书信息，保存后可查看证书预览</text>
  </view>

  <view class="form-card">
    <view class="form-row">
      <text class="form-label required">证书编号</text>
      <input class="form-input" placeholder="请输入证书编号" value="{{form.certNo}}" bindinput="onFieldInput" data-field="certNo"/>
    </view>
    <view class="form-row" bind:tap="showBreedPicker" data-field="fatherBreed">
      <text class="form-label required">父亲品种</text>
      <text class="form-value {{form.fatherBreed ? '' : 'placeholder'}}">{{form.fatherBreed || '请选择'}}</text>
      <text class="form-arrow">›</text>
    </view>
    <view class="form-row" bind:tap="showBreedPicker" data-field="motherBreed">
      <text class="form-label required">母亲品种</text>
      <text class="form-value {{form.motherBreed ? '' : 'placeholder'}}">{{form.motherBreed || '请选择'}}</text>
      <text class="form-arrow">›</text>
    </view>
    <view class="form-row">
      <text class="form-label">繁育者</text>
      <input class="form-input" placeholder="犬舍/猫舍名称" value="{{form.breeder}}" bindinput="onFieldInput" data-field="breeder"/>
    </view>
    <view class="form-row">
      <text class="form-label">证书照片</text>
      <text class="form-value photo-upload" bind:tap="uploadPhoto">{{form.certPhoto ? '已上传' : '点击上传'}}</text>
      <text class="form-arrow">›</text>
    </view>
  </view>

  <view class="save-section">
    <view class="btn-primary" bind:tap="saveRecord">保存</view>
  </view>
</scroll-view>

<!-- 品种选择面板 -->
<view class="sheet-overlay {{showBreedPicker ? 'show' : ''}}" bind:tap="hideBreedPicker">
  <view class="sheet-panel" catch:tap="">
    <view class="sheet-header">
      <text class="sheet-title">选择品种</text>
      <text class="sheet-close" bind:tap="hideBreedPicker">✕</text>
    </view>
    <view class="breed-tabs">
      <view class="breed-tab {{breedTab === 'cat' ? 'active' : ''}}" bind:tap="switchBreedTab" data-tab="cat">🐱 猫</view>
      <view class="breed-tab {{breedTab === 'dog' ? 'active' : ''}}" bind:tap="switchBreedTab" data-tab="dog">🐶 狗</view>
    </view>
    <scroll-view class="breed-list" scroll-y>
      <view wx:for="{{breedOptions}}" wx:key="*this" class="breed-option" bind:tap="selectBreed" data-breed="{{item}}">
        {{item}}
      </view>
    </scroll-view>
  </view>
</view>
