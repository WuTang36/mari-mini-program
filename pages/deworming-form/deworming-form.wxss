page { height: 100%; display: flex; flex-direction: column; background: var(--color-bg); }
.page-scroll { flex: 1; overflow-y: auto; padding: 24rpx 0; }
.form-card { margin: 0 56rpx 28rpx; background: var(--color-card); border-radius: 32rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); }
.form-row { display: flex; align-items: center; padding: 32rpx 36rpx; border-bottom: 2rpx solid var(--color-border); min-height: 96rpx; }
.form-row:last-child { border-bottom: none; }
.form-label { font-size: 28rpx; font-weight: 600; color: var(--color-text-secondary); width: 140rpx; flex-shrink: 0; }
.form-label.required::after { content: ' *'; color: var(--color-danger); font-size: 24rpx; }
.form-value { flex: 1; font-size: 28rpx; color: var(--color-text); text-align: right; }
.form-value.placeholder { color: var(--color-text-placeholder); }
.form-input { flex: 1; font-size: 28rpx; color: var(--color-text); text-align: right; border: none; background: none; outline: none; }
.form-arrow { font-size: 28rpx; color: #CCC; flex-shrink: 0; margin-left: 12rpx; }
.save-section { margin: 0 56rpx; padding: 24rpx 0 80rpx; }

.sheet-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 1000; display: none; align-items: flex-end; }
.sheet-overlay.show { display: flex; }
.sheet-panel { box-sizing: border-box; width: 100%; background: #fff; border-radius: 40rpx 40rpx 0 0; max-height: 600rpx; display: flex; flex-direction: column; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; padding: 36rpx 40rpx 24rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { font-size: 36rpx; color: #CCC; }
.date-picker-view { box-sizing: border-box; width: 100%; height: 400rpx; }
.picker-item { display: flex; align-items: center; justify-content: center; height: 50px; font-size: 28rpx; }
.sheet-footer { padding: 0 40rpx; }
